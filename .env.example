# Local-only PostgreSQL from compose.yml. Never use these credentials in production.
DATABASE_URL=postgresql://neurogranada:local-development-only@localhost:5432/neurogranada
# Optional: inferred as neon for *.neon.tech, postgres otherwise.
DATABASE_DRIVER=postgres
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Feature-specific services. Obtain credentials separately; do not commit secrets.
AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_BLOB_URL=
CARTESIA_API_KEY=
SERPER_API_KEY=

# Local Vercel Sandbox authentication: obtain a short-lived project OIDC token.
# The app does not pass explicit token/team/project SDK options.
VERCEL_OIDC_TOKEN=
# Required for generation/preview. Pick a unique, stable value per local DB or PR.
# Example: local-angel / preview-pr-31 / production (1–24 lowercase slug characters).
SANDBOX_NAMESPACE=
# Snapshot source must be a revision available on GitHub, not an unpushed branch.
SANDBOX_BRANCH=main

# One-time bootstrap only. Remove after use; no defaults for administrator credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
